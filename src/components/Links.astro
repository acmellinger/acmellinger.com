---
interface Props {
  linkedin: string;
  github: string;
  url: string;
  mysite: string;
  sitekey: string;
}

const { linkedin, github, url, mysite, sitekey } = Astro.props;
const localBypassEnabled =
  import.meta.env.DEV &&
  import.meta.env.PUBLIC_TURNSTILE_LOCAL_BYPASS === "true";
const localTestEmail = import.meta.env.PUBLIC_TEST_EMAIL ?? "local@example.com";
---

<div class="links-wrap">
  <nav class="links" role="group" aria-label="Primary links">
    <button aria-label="Reveal Email" id="emailBtn" class="action">
      <svg class="icon" viewBox="0 0 24 24">
        <path
          fill="currentColor"
          d="M22 5.5H9c-1.1 0-2 .9-2 2v9a2 2 0 0 0 2 2h13c1.11 0 2-.89 2-2v-9a2 2 0 0 0-2-2m0 11H9V9.17l6.5 3.33L22 9.17zm-6.5-5.69L9 7.5h13zM5 16.5c0 .17.03.33.05.5H1c-.552 0-1-.45-1-1s.448-1 1-1h4zM3 7h2.05c-.02.17-.05.33-.05.5V9H3c-.55 0-1-.45-1-1s.45-1 1-1m-2 5c0-.55.45-1 1-1h3v2H2c-.55 0-1-.45-1-1"
        ></path>
      </svg>
      <span>Email</span>
    </button>
    <a
      class="action"
      title="LinkedIn"
      aria-label="My LinkedIn"
      target="_blank"
      rel="noopener noreferrer"
      href={linkedin}
    >
      <svg class="icon" viewBox="0 0 24 24">
        <path
          fill="currentColor"
          d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z"
        ></path>
      </svg>
      <span>LinkedIn</span>
    </a>
    <a
      class="action"
      title="GitHub"
      aria-label="My GitHub"
      target="_blank"
      rel="noopener noreferrer"
      href={github}
    >
      <svg class="icon" viewBox="0 0 24 24">
        <path
          fill="currentColor"
          d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
        ></path>
      </svg>
      <span>GitHub</span>
    </a>
  </nav>

  <div id="email-container" class="email-container" aria-live="polite">
    <a id="emailtext" class="emailtext" tabindex="-1"></a>
    <span id="statustext" class="statustext"></span>
  </div>
</div>

<div
  class="cf-turnstile turnstile"
  id="turnstile-widget"
  data-sitekey={sitekey}
  data-callback="onTurnstileSuccess"
  data-error-callback="onTurnstileError"
  data-expired-callback="onTurnstileExpired"
  data-execution="execute"
>
</div>

<script
  is:inline
  define:vars={{ url, mysite, localBypassEnabled, localTestEmail }}
>
  function setStatus(message) {
    const statusText = document.getElementById("statustext");
    if (statusText) {
      statusText.innerText = message;
    }
  }

  function setEmail(email) {
    const anchorElement = document.getElementById("emailtext");
    if (anchorElement) {
      anchorElement.setAttribute(
        "href",
        "mailto:" + email + "?subject=Website Contact",
      );
      anchorElement.innerText = email;
      anchorElement.removeAttribute("tabindex");
    }
  }

  function setVerifyingState(loading) {
    const button = document.getElementById("emailBtn");
    if (button) {
      button.toggleAttribute("disabled", loading);
      button.setAttribute("aria-busy", loading ? "true" : "false");
    }
  }

  window.onTurnstileError = function () {
    setVerifyingState(false);
    setStatus("Verification unavailable");
  };

  window.onTurnstileExpired = function () {
    setVerifyingState(false);
    setStatus("Verification expired");
  };

  window.onTurnstileSuccess = async function (token) {
    let timeout;
    try {
      const controller = new AbortController();
      timeout = window.setTimeout(() => controller.abort(), 10000);
      const response = await fetch(url, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ Token: token, Site: mysite }),
        signal: controller.signal,
      });

      if (response.status !== 200) {
        throw new Error("Validation failed");
      }

      const rjson = await response.json();
      const email = rjson["email"];
      const isValidEmail =
        typeof email === "string" &&
        email.length > 3 &&
        email.includes("@") &&
        email.includes(".");

      if (!isValidEmail) {
        throw new Error("Invalid response");
      }

      setEmail(email);
      setStatus("");
    } catch (e) {
      setStatus("Verification failed");
      if (window.turnstile) {
        window.turnstile.reset("#turnstile-widget");
      }
    } finally {
      if (timeout) {
        window.clearTimeout(timeout);
      }
      setVerifyingState(false);
    }
  };
</script>

<script
  is:inline
  define:vars={{ localBypassEnabled, localTestEmail, sitekey, url, mysite }}
>
  function loadTurnstile() {
    return new Promise((resolve, reject) => {
      if (window.turnstile) {
        resolve();
        return;
      }
      let script = document.getElementById("turnstile-script");
      if (!script) {
        script = document.createElement("script");
        script.id = "turnstile-script";
        script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
        script.async = true;
        script.defer = true;
        document.head.appendChild(script);
      }
      script.addEventListener("load", () => resolve());
      script.addEventListener("error", () =>
        reject(new Error("Failed to load Turnstile")),
      );
    });
  }

  function onEmailClick() {
    const button = document.getElementById("emailBtn");
    if (button?.getAttribute("aria-busy") === "true") {
      return;
    }

    if (localBypassEnabled) {
      const anchorElement = document.getElementById("emailtext");
      if (anchorElement) {
        anchorElement.setAttribute(
          "href",
          "mailto:" + localTestEmail + "?subject=Website Contact",
        );
        anchorElement.innerText = localTestEmail;
      }
      const statusText = document.getElementById("statustext");
      if (statusText) {
        statusText.innerText = "Local test mode";
      }
      return;
    }

    const statusText = document.getElementById("statustext");
    if (statusText) {
      statusText.innerText = "Verifying";
    }

    const emailElement = document.getElementById("emailtext");
    if (emailElement) {
      emailElement.innerText = "";
      emailElement.removeAttribute("href");
    }

    if (!sitekey || !url || !mysite) {
      if (statusText) {
        statusText.innerText = "Missing Turnstile configuration";
      }
      return;
    }

    if (button) {
      button.setAttribute("aria-busy", "true");
      button.toggleAttribute("disabled", true);
    }

    loadTurnstile()
      .then(() => {
        if (window.turnstile && window.turnstile.execute) {
          window.turnstile.execute("#turnstile-widget");
        } else {
          throw new Error("Turnstile unavailable");
        }
      })
      .catch(() => {
        if (button) {
          button.setAttribute("aria-busy", "false");
          button.removeAttribute("disabled");
        }
        if (statusText) {
          statusText.innerText = "Verification unavailable";
        }
      });
  }

  const button = document.getElementById("emailBtn");
  if (button) {
    button.addEventListener("click", onEmailClick);
  }
</script>

<style>
  .links-wrap {
    display: grid;
    gap: 0.9rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .action {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--text);
    padding: 0.66rem 1.02rem;
    text-decoration: none;
    text-transform: uppercase;
    font-family: "Montserrat", "Avenir Next", "Segoe UI", sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .action:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .action:hover {
    background: #f4f1eb;
    border-color: #b9ad99;
    color: var(--text);
    outline: none;
  }

  .action:focus-visible {
    background: #f4f1eb;
    border-color: #b9ad99;
    color: var(--text);
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  :global(.icon) {
    color: currentColor;
    width: 0.95rem;
    height: 0.95rem;
  }

  .email-container {
    min-height: 1.6rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .emailtext {
    color: var(--text);
    font-family: "Montserrat", "Avenir Next", "Segoe UI", sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-underline-offset: 0.14em;
    overflow-wrap: anywhere;
  }

  .statustext {
    color: var(--muted);
    font-family: "Montserrat", "Avenir Next", "Segoe UI", sans-serif;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .statustext:empty {
    display: none;
  }

  .turnstile {
    position: absolute;
    width: 0;
    height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .action {
      width: 100%;
      justify-content: center;
    }
  }
</style>
